# Postgres connection string
# The app creates its own tables here on first boot, so an empty database is fine.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Vercel Blob API token — auto-injected when you create a Blob store on Vercel
BLOB_READ_WRITE_TOKEN=

# HMAC secret used to sign login sessions. Must be 32+ chars and kept private.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Password you type to reach the dashboard
AUTH_PASSWORD=

# Custom domain that serves public files (optional).
# Leave unset in development — files are served from /f/:name instead.
# CDN_HOST=cdn.example.com
# NEXT_PUBLIC_CDN_HOST=cdn.example.com

# Demo mode (optional). Set BOTH to "true" to run a public showcase instance:
#   - login accepts the fixed password "outofmemory" (AUTH_PASSWORD not needed)
#   - the dashboard & gallery are pre-seeded with the bundled files in public/demo
#   - renames / deletes / uploads are faked & never persist (reset on reload)
#   - needs NO database or Blob store — DATABASE_URL / BLOB_READ_WRITE_TOKEN can be empty
# Leave both unset for a normal self-hosted instance.
# DEMO_MODE=true
# NEXT_PUBLIC_DEMO_MODE=true

# Stop the app creating its own schema (optional). Only for least-privilege setups where you
# run `pnpm db:push` yourself with a role that can create tables.
# SKIP_DB_BOOTSTRAP=true
